            <run fontcolor='#000000' fontname='Benton Sans Book'>Inventory Days-of-Supply</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='DataCo_Clean' name='federated.03xbdky1f1cmc81658dew1x9wapv' />
          </datasources>
          <datasource-dependencies datasource='federated.03xbdky1f1cmc81658dew1x9wapv'>
            <column caption='Avg Daily Demand' datatype='real' name='[Avg_Daily_Demand]' role='dimension' type='ordinal' />
            <column caption='Days of Supply' datatype='real' name='[Calculation_0036040071831553]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Avg_Daily_Demand] &lt; 0.1 THEN NULL ELSE [Current_Stock] / [Avg_Daily_Demand] END' />
            </column>
            <column caption='Risk_Flag' datatype='string' name='[Calculation_0036040073224195]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_0036040071831553] &lt; 40 THEN (&quot;At Risk&quot;)&#13;&#10;ELSEIF [Calculation_0036040071831553] &lt; 60 THEN(&quot;Watch&quot;)&#13;&#10;ELSE (&quot;Healthy&quot;) END' />
            </column>
            <column caption='Category (warehouse inventory.csv)' datatype='string' name='[Category (warehouse_inventory.csv)]' role='dimension' type='nominal' />
            <column caption='Current Stock' datatype='integer' name='[Current_Stock]' role='measure' type='quantitative' />
            <column datatype='string' name='[Warehouse]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_0036040073224195]' derivation='None' name='[none:Calculation_0036040073224195:nk]' pivot='key' type='nominal' />
