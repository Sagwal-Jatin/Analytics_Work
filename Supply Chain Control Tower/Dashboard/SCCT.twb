      <aliases enabled='yes' />
      <column caption='Avg Daily Demand' datatype='real' name='[Avg_Daily_Demand]' role='dimension' type='ordinal' />
      <column caption='Days of Supply' datatype='real' name='[Calculation_0036040071831553]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Avg_Daily_Demand] &lt; 0.1 THEN NULL ELSE [Current_Stock] / [Avg_Daily_Demand] END' />
      </column>
      <column caption='Risk_Flag' datatype='string' name='[Calculation_0036040073224195]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_0036040071831553] &lt; 40 THEN (&quot;At Risk&quot;)&#13;&#10;ELSEIF [Calculation_0036040071831553] &lt; 60 THEN(&quot;Watch&quot;)&#13;&#10;ELSE (&quot;Healthy&quot;) END' />
      </column>
      <column caption='Estimated Cost Impact' datatype='real' name='[Calculation_0036040080064516]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Order Item Total] * [Current_Rate_2026])' />
      </column>
      <column caption='On Time Flag' datatype='integer' name='[Calculation_0125650183700480]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Days for shipping (real)] &lt;= [Days for shipment (scheduled)] THEN 1 ELSE 0 END' />
      </column>
      <column caption='On-Time %' datatype='real' name='[Calculation_0125650183819265]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_0125650183700480]) / COUNT([Order Id])' />
      </column>
      <column caption='Delay Days' datatype='integer' name='[Calculation_0125650189332482]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Days for shipping (real)] - [Days for shipment (scheduled)]' />
      </column>
      <column caption='Lead Time Variability' datatype='real' name='[Calculation_0125650200354819]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='STDEV([Days for shipping (real)])' />
      </column>
